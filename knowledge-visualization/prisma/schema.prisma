datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
    output   = "../node_modules/.prisma/client"
}

generator erd {
    provider    = "prisma-erd-generator"
    output      = "../ERD.png"
    ignoreEnums = true
    disabled    = DISABLE_ERD
}

enum Language {
    ja
    en
}

enum Permission {
    OWNER
    EDITOR
    VIEWER
}

enum NotificationType {
    DIAGRAM_SHARED
    FOLDER_SHARED
    TEAM_SHARED
    USER_INVITED
}

enum Plan {
    Free
    Plus
    Pro
}

model Account {
    id                String  @id @default(cuid())
    userId            String  @map("user_id")
    type              String
    provider          String
    providerAccountId String  @map("provider_account_id")
    refresh_token     String? @db.Text
    access_token      String? @db.Text
    expires_at        Int?
    token_type        String?
    scope             String?
    id_token          String? @db.Text
    session_state     String?

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([provider, providerAccountId])
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique @map("session_token")
    userId       String   @map("user_id")
    expires      DateTime

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
    id            String    @id @default(cuid())
    name          String?
    email         String?   @unique
    emailVerified DateTime? @map("email_verified")
    image         String?
    password      String?
    language      Language  @default(en)
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt
    plan          Plan      @default(Free)

    accounts Account[]
    sessions Session[]

    teamMembers    TeamMember[]
    createdFolders Folder[]       @relation("FolderOwner")
    diagrams       Diagram[]      @relation("DiagramOwner")
    shares         Share[]
    recents        Recent[]
    trashes        Trash[]
    starreds       Starred[]
    notifications  Notification[]
}

model VerificationToken {
    id      String   @id @default(cuid())
    email   String
    token   String   @unique
    expires DateTime

    @@unique([email, token])
}

model PasswordResetToken {
    id      String   @id @default(cuid())
    email   String
    token   String   @unique
    expires DateTime

    @@unique([email, token])
}

model PasswordChangeToken {
    id          String   @id @default(cuid())
    email       String
    token       String   @unique
    newPassword String
    expires     DateTime

    @@unique([email, token])
}

model Team {
    id        String   @id @default(cuid())
    name      String
    imageUrl  String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    plan      Plan     @default(Free)

    members  TeamMember[]
    folders  Folder[]
    diagrams Diagram[]
}

model TeamMember {
    id         String     @id @default(cuid())
    teamId     String
    userId     String
    permission Permission @default(VIEWER)
    joinedAt   DateTime   @default(now())

    team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([teamId, userId])
}

model Folder {
    id        String   @id @default(cuid())
    name      String
    ownerId   String   @map("owner_id")
    parentId  String?
    teamId    String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    parent Folder? @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
    owner  User    @relation("FolderOwner", fields: [ownerId], references: [id])
    team   Team?   @relation(fields: [teamId], references: [id], onDelete: Cascade)
    trash  Trash?

    children Folder[]  @relation("FolderHierarchy")
    diagrams Diagram[]
    shares   Share[]

    @@unique([name, parentId, teamId])
}

model Diagram {
    id        String   @id @default(cuid())
    title     String
    imageUrl  String?
    folderId  String?
    ownerId   String?
    teamId    String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    folder   Folder?   @relation(fields: [folderId], references: [id], onDelete: Cascade)
    owner    User?     @relation("DiagramOwner", fields: [ownerId], references: [id], onDelete: Cascade)
    team     Team?     @relation(fields: [teamId], references: [id], onDelete: Cascade)
    shares   Share[]
    recents  Recent[]
    trash    Trash?
    starreds Starred[]

    @@unique([title, folderId, teamId])
}

model Trash {
    id          String   @id @default(cuid())
    folderId    String?  @unique
    diagramId   String?  @unique
    deletedById String   @map("deleted_by_id")
    deletedAt   DateTime @default(now())

    diagram   Diagram? @relation(fields: [diagramId], references: [id], onDelete: Cascade)
    folder    Folder?  @relation(fields: [folderId], references: [id], onDelete: Cascade)
    deletedBy User     @relation(fields: [deletedById], references: [id])
}

model Share {
    id         String     @id @default(cuid())
    folderId   String?
    diagramId  String?
    userId     String?
    permission Permission @default(VIEWER)
    sharedAt   DateTime   @default(now())

    diagram Diagram? @relation(fields: [diagramId], references: [id], onDelete: Cascade)
    folder  Folder?  @relation(fields: [folderId], references: [id], onDelete: Cascade)
    user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Recent {
    id        String   @id @default(cuid())
    userId    String
    diagramId String
    viewedAt  DateTime @default(now())

    user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    diagram Diagram @relation(fields: [diagramId], references: [id], onDelete: Cascade)

    @@unique([userId, diagramId])
}

model Starred {
    id        String   @id @default(cuid())
    userId    String
    diagramId String
    starredAt DateTime @default(now())

    user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    diagram Diagram @relation(fields: [diagramId], references: [id], onDelete: Cascade)

    @@unique([userId, diagramId])
}

model Notification {
    id        String           @id @default(cuid())
    userId    String
    title     String
    content   String
    type      NotificationType
    relatedId String?          @map("related_id")
    read      Boolean          @default(false)
    createdAt DateTime         @default(now())
    updatedAt DateTime         @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
